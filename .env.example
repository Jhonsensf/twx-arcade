# Copia este archivo como .env (solo para probar en tu portátil).
# En Railway estas tres claves se ponen en "Variables", no en un archivo.

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: tu ID de usuario de Slack. Si lo pones, solo tú puedes ver /twx resultados.
ADMIN_USER_ID=

# Opcional: modelo de Claude (por defecto, uno rápido y barato).
CLAUDE_MODEL=claude-haiku-4-5
